[Unit]
Description=Prepare role-scoped Rogimarble runtime secrets
Before=rogimarble-app.service
ConditionPathExists=/etc/rogimarble/secrets-manager.json

[Service]
RuntimeDirectory=rogimarble
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Type=oneshot
ExecStart=/usr/local/lib/rogimarble/prepare-secrets.sh
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/rogimarble/secrets-manager.json
ReadWritePaths=/run/rogimarble

[Install]
WantedBy=multi-user.target
