[Unit]
Description=Prepare role-scoped Rogimarble runtime secrets
Before=rogimarble-app.service
ConditionPathIsDirectory=/etc/rogimarble/secrets

[Service]
Type=oneshot
ExecStart=/usr/local/lib/rogimarble/prepare-secrets.sh
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/rogimarble/secrets
ReadWritePaths=/run/rogimarble

[Install]
WantedBy=multi-user.target
