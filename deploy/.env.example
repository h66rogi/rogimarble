# Local preview only. Copy to deploy/.env with tools/ops/preview.sh init.
COMPOSE_PROJECT_NAME=rogimarble-preview
EDGE_BIND=127.0.0.1
EDGE_PORT=8080
POSTGRES_DB=rogimarble
POSTGRES_USER=rogimarble_app
POSTGRES_PASSWORD=replace-with-generated-local-value
SESSION_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_CHANNEL_ID=preview
