{
	admin localhost:2019
	{$ACME_EMAIL_DIRECTIVE}
}

(api_pool) {
	reverse_proxy api-blue:4000 api-green:4000 {
		lb_policy first
		health_uri /ready
		health_interval 1s
		health_timeout 1s
		fail_duration 5s
		max_fails 1
		lb_try_duration 5s
		lb_try_interval 100ms
		stream_close_delay 15s
	}
}

(web_pool) {
	reverse_proxy web-blue:3000 web-green:3000 {
		lb_policy first
		health_uri /healthz
		health_interval 1s
		health_timeout 1s
		fail_duration 5s
		max_fails 1
		lb_try_duration 5s
		lb_try_interval 100ms
	}
}

{$WEB_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle /socket.io/* {
		import api_pool
	}
	handle_path /api/* {
		import api_pool
	}
	handle {
		import web_pool
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	import api_pool
}
